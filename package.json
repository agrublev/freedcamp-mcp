{
  "name": "freedcamp-mcp-server",
  "version": "1.1.3",
  "description": "MCP server for using the Freedcamp API",
  "license": "MIT",
  "author": "Freedcamp https://freedcamp.com",
  "homepage": "https://freedcamp.com",
  "bugs": "https://github.com/agrublev/freedcamp-mcp/issues",
  "type": "module",
  "bin": {
    "freedcamp-mcp-server": "index.js"
  },
  "files": [
    "index.js",
    "common/",
    "operations/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
